# PostgreSQL Connection Configuration
# Copy this file to .env and update with your credentials

# PostgreSQL user (default: postgres)
POSTGRES_USER=postgres

# PostgreSQL password (required for connection)
POSTGRES_PASSWORD=ilove

# PostgreSQL database name (default: postgres)
POSTGRES_DB=postgres

# PostgreSQL host (default: localhost)
POSTGRES_HOST=localhost

# PostgreSQL port (default: 5432)
POSTGRES_PORT=5432

# Azure Configuration
AZURE_ENABLED=False
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_CONTAINER=circuits
AZURE_TABLE=circuits
