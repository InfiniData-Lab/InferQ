# Copy this file to .env and fill in your own values.

# --- PostgreSQL (OOC and fine-tuned RDBMS experiments) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Azure ---
# Set to True to enable blob and table storage in the production pipeline.
AZURE_ENABLED=False

# Required whenever AzureConnection is constructed. Missing values raise
# AzureCredentialsError naming exactly which ones are absent.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_SAS_TOKEN=
AZURE_CONTAINER_SAS_URL=

# Optional. When set, the account key is preferred over the SAS token, because
# it is the only method that reliably authorizes Table operations.
AZURE_STORAGE_ACCOUNT_KEY=

# Container and table names used by the storage helpers.
AZURE_CONTAINER=circuits
AZURE_TABLE=circuits

# --- Storage ---
# When set, circuits are written under this path instead of the project root.
ABSOLUTE_STORAGE_PATH=
