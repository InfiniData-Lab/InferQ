# Copy this file to .env and fill in your own values.

# --- PostgreSQL (OOC and fine-tuned RDBMS experiments) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Cloud storage ---
# Which backend `inferq.remote` talks to: azure (Blob + Table) or aws (S3 +
# DynamoDB). When unset it is inferred: AWS_S3_BUCKET or AWS_DYNAMODB_TABLE
# present means aws, otherwise azure. Only those two count as intent, because
# AWS_REGION and credentials are ambient on any AWS host and must not silently
# switch an Azure deployment over.
INFERQ_CLOUD_PROVIDER=

# Set to True to enable object and metadata upload in the production pipeline.
# Provider-neutral; AZURE_ENABLED is still read as an alias.
CLOUD_ENABLED=False

# Object container / bucket and metadata table names. Provider-neutral, with
# AZURE_CONTAINER and AZURE_TABLE accepted as aliases.
CLOUD_BUCKET=circuits
CLOUD_TABLE=circuits

# How often the pipeline flushes a batch to the cloud, in seconds.
# Alias: AZURE_INTERVAL.
CLOUD_UPLOAD_INTERVAL=

# --- Azure ---
# Required whenever AzureConnection is constructed. Missing values raise
# AzureCredentialsError naming exactly which ones are absent.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_SAS_TOKEN=
AZURE_CONTAINER_SAS_URL=

# Optional. When set, the account key is preferred over the SAS token, because
# it is the only method that reliably authorizes Table operations.
AZURE_STORAGE_ACCOUNT_KEY=

# Container and table names used by the storage helpers. Prefer the neutral
# CLOUD_BUCKET / CLOUD_TABLE above; these remain as aliases.
AZURE_CONTAINER=circuits
AZURE_TABLE=circuits

# --- AWS ---
# Required whenever AwsConnection is constructed. Missing values raise
# AwsCredentialsError naming exactly which ones are absent.
AWS_REGION=
AWS_S3_BUCKET=
AWS_DYNAMODB_TABLE=

# Optional. Authentication uses boto3's default credential chain -- IAM role,
# instance profile, SSO, shared config -- which is what a deployment running
# inside AWS should rely on, and needs no secrets here. Set these only to
# override that chain, for local development or CI.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional. Named profile from ~/.aws/config.
AWS_PROFILE=

# Optional. Points both S3 and DynamoDB at a local stand-in such as LocalStack
# or MinIO, e.g. http://localhost:4566.
AWS_ENDPOINT_URL=

# --- Storage ---
# When set, circuits are written under this path instead of the project root.
ABSOLUTE_STORAGE_PATH=
