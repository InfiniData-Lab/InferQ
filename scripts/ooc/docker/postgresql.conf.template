# Templated at container start from env var CAP_GB. See pg_entrypoint.sh.
# Values chosen for out-of-core experiments: modest shared_buffers so the planner
# must spill to temp files on big aggregates, generous temp_file_limit so spill
# actually completes within the cgroup cap.

listen_addresses = '*'
port = 5432

# Memory sizing (values in MB; entrypoint substitutes ${VAR} placeholders)
shared_buffers = ${SHARED_BUFFERS_MB}MB
work_mem = ${WORK_MEM_MB}MB
maintenance_work_mem = ${MAINT_WORK_MEM_MB}MB
effective_cache_size = ${EFFECTIVE_CACHE_MB}MB
temp_file_limit = ${TEMP_FILE_LIMIT_KB}kB

# Logging — surface every temp file so we can grep spill stats from container logs
log_destination = 'stderr'
logging_collector = off
log_temp_files = 0
log_statement = 'none'
log_min_duration_statement = 60000

# Background tuning — keep simple, reproducible
max_connections = 16
random_page_cost = 1.1
max_wal_size = 1GB
min_wal_size = 80MB
checkpoint_completion_target = 0.9

# Concurrency — match i9-12900KF (24 threads); worker defaults to single query at a time
max_worker_processes = 16
max_parallel_workers = 16
max_parallel_workers_per_gather = 8
