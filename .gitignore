# --- Python ---
__pycache__/
*.py[cod]
.venv
venv
.DS_Store

# --- Build artifacts ---
build/
dist/
*.egg-info/

# --- Secrets and local environment ---
.env
acct.key

# --- Editors and scratch ---
.kiro
playground.ipynb

# --- Generated circuits and caches ---
circuits/
circuits_hpc/
circuit_hashes_cache.json
test_circuits/
pgdata/

# --- Logs ---
logs/
*.log

# --- Bulk data formats ---
# Circuits and dataframes are large and reproducible; the exceptions below name
# the artifacts that are intentionally versioned.
*.qpy
*.parquet
*.csv
*.jsonl

# --- Generated figures and result blobs ---
# Regenerable from the scripts under analysis/ and scripts/ooc/.
*.png
*.pdf
analysis/**/results.json
analysis/analysis_results.json
analysis/deep_benchmark_results.json
analysis/extremes_results.json
analysis/scalability/profiling_stats_*.json
analysis/**/*_hashes.txt
analysis/**/*_qpy_paths.txt
analysis/**/*_selection_summary.json
analysis/**/*_profile_tunings.json
analysis/ablation_results/splits/*.npz
scripts/ooc/results/
scripts/finetuned_rdbms/profiles/*_qpy_paths.txt

# --- Versioned data (exceptions to the rules above) ---
data/*
!data/metadata/
!data/metadata/*.parquet
!data/ooc/
!data/ooc/*.jsonl

# Training datasets consumed by the estimator and selector notebooks.
!analysis/training_data/*.parquet

# Benchmark suite inventories.
!scripts/benchmark_suites/benchmark_algorithms_deduplicated.csv
!scripts/benchmark_suites/benchmark_algorithms_full.csv

# Fine-tuning baselines and profiles.
!scripts/finetuned_rdbms/baselines/*.csv
!scripts/finetuned_rdbms/profiles/*.json
!scripts/finetuned_rdbms/profiles/small_median_hashes.txt

# Sample circuit selections referenced by analysis notebooks.
!analysis/sample_csvs/
!analysis/sample_csvs/*.csv
